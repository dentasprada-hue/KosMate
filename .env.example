# Salin file ini menjadi .env.local dan isi nilai sebenarnya.
# JANGAN pernah commit service_role / secret key ke repo.
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...anon...
# 0 = tanpa login (prototype), 1 = wajib login pakai Supabase Auth
EXPO_PUBLIC_AUTH_ENABLED=0